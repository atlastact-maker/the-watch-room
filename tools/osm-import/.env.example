# Copy this file to .env and fill in the two values (never commit .env).
# Both are on the Supabase dashboard: Project Settings → API.
SUPABASE_URL=https://your-project-ref.supabase.co
# The service_role key, not the anon key — the import writes tables that
# nothing else may write. Treat it like a password.
SUPABASE_SERVICE_ROLE_KEY=paste-service-role-key-here
