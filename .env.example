# Copy this file to `.env.local` and fill in real values.
# .env.local is gitignored; .env.example (this file) is committed.

# Supabase project URL — looks like https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key — long JWT starting "eyJ..."
# This is safe to expose to the browser; do NOT use the service-role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# (Optional) Ordnance Survey OS Maps API key — get one at os.uk/os-maps-api.
# When set, the dashboard map exposes OS Light, OS Outdoor and OS Road tile layers
# alongside the free OSM / dark / satellite / topographic basemaps.
NEXT_PUBLIC_OS_MAPS_API_KEY=

# OpenRouteService API key — get one at openrouteservice.org/dev.
# SERVER-ONLY: do not add a NEXT_PUBLIC_ prefix. Used by the /api/route-eta
# route handler to fetch driving directions with geometry for ghost-movers.
# Free tier: 2000 requests/day, 40/minute.
ORS_API_KEY=

# Resend API key — get one at resend.com. SERVER-ONLY: do not add a
# NEXT_PUBLIC_ prefix. Used to send the advisor acceptance email when an
# application is approved in /admin. Supabase's own auth emails
# (confirmation, password reset) go through Supabase's SMTP settings and
# do not read this.
# Without it, accepting an advisor still works — the email is skipped and
# the reason is logged.
RESEND_API_KEY=

# (Optional) Sender for app-sent email. Must be on a domain verified in
# Resend; a gmail.com sender is rejected by Gmail's DMARC policy.
# Defaults to "The Watch Room <noreply@thewtchroom.co.uk>".
EMAIL_FROM=

# (Optional) Site origin used in app-sent email links and the logo.
# Defaults to https://thewtchroom.co.uk.
NEXT_PUBLIC_SITE_URL=
